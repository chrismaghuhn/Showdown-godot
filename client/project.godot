; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Showdown Desktop"
config/description="Community desktop client for Pokémon Showdown"
config/version="0.1.0"
run/main_scene="res://src/app/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

AppConfig="*res://src/core/app_config.gd"
EventBus="*res://src/core/event_bus.gd"
Connection="*res://src/net/connection.gd"
Rooms="*res://src/core/room_manager.gd"
GameData="*res://src/core/game_data.gd"
Themes="*res://src/ui/theme/theme_manager.gd"
Plugins="*res://src/plugins/plugin_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
